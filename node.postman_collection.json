        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "const token = response.token || response.accessToken || response.access_token || (response.data && (response.data.token || response.data.accessToken || response.data.access_token));\r",
                  "\r",
                  "if (token) {\r",
                  "    pm.environment.set(\"token\", token);\r",
                  "    console.log(\"Token saved:\", token);\r",
                  "} else {\r",
                  "    console.log(\"Token not found in response:\", JSON.stringify(response));\r",
                  "}\r",
                  "\r",
                  "pm.test(\"Token extracted and saved\", function () {\r",
                  "    pm.expect(token).to.not.be.undefined;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
